package com.recipe.app.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.client.WebClient;

import com.recipe.app.dto.RecipeRecommendationRequest;
import com.recipe.app.dto.RecipeResponseDto;

import reactor.core.publisher.Mono;

@Service
public class RecipeRecommendationService {
	private final WebClient webClient;  // 비동기 HTTP 클라이언트
	
	// application.properties에 제미나이 주소 들어갈 주소 넣기
	 public RecipeRecommendationService(@Value("${python.gemini.service.url}") String pythonGeminiServiceUrl) {
		this.webClient = WebClient.builder()
				.baseUrl(pythonGeminiServiceUrl)
				.build();
	}
	
	public Mono<List<RecipeResponseDto>> getRecommendedRecipes(String ingredients) {
		RecipeRecommendationRequest request = new RecipeRecommendationRequest();
		request.getIngredients();
		
		
	}
}

